backend/data/taskmanager.db-wal
backend/data/taskmanager.db-shm

# Pytest SQLite (never commit)
backend/tests/data/test_taskmanager.db
backend/tests/data/test_taskmanager.db-wal
backend/tests/data/test_taskmanager.db-shm

# User-uploaded files (runtime data)
backend/data/attachments/
backend/data/project_media/

