# Frontend mode API URLs are NOT secrets — keep .env.development / .env.production
# trackable so `vite build` / CI have VITE_API_URL. Local overrides use *.local above.

# Aurora IAM token cache (runtime — never commit)
backend/.cache/

# Database (runtime data — never commit)
