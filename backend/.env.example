# ZET backend — environment template. Copy to backend/.env and fill real values.
# In production (APP_ENV=production) the app FAILS TO START if the secrets marked
# "required in prod" are missing or left at dev defaults.

# ── Microsoft (sign-in + Teams transcripts) ─────────────────────────────────
MICROSOFT_CLIENT_ID=            # Entra app (client) ID; same as VITE_MICROSOFT_CLIENT_ID
MICROSOFT_TENANT_ID=            # Directory (tenant) ID; real id, NOT "common"
MICROSOFT_CLIENT_SECRET=        # client secret — ONLY needed for Teams → MOM import

# ── AI: DeepSeek V4 Flash (chat, agent, parse, insights) ────────────────────
DEEPSEEK_API_KEY=               # required for any LLM feature
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_STRICT_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=8192
# AI_REQUEST_TIMEOUT=45
# AI_MAX_RETRIES=2

# ── AI: Groq Whisper (voice / scrum audio — unchanged) ──────────────────────
GROQ_API_KEY=                   # required for speech-to-text
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Auth (required in prod) ─────────────────────────────────────────────────
APP_ENV=development             # set "production" to enforce the checks
TASKMANAGER_JWT_SECRET=         # >=32 chars in prod
# No admin-console password: the superadmin is a normal user row (role="superadmin").
# REQUIRED in prod. Exact browser origins of the frontend — scheme + host + port,
# NO trailing slash, comma-separated. There is no longer an allow-all fallback, so
# a mismatch here blocks every request from the app with a CORS error.
#   e.g. CORS_ORIGINS=https://zet.driftal.tech,https://www.zet.driftal.tech
CORS_ORIGINS=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Login / sign-up limits are per client IP. Behind a load balancer, CDN or reverse
# proxy every request arrives from the proxy's IP, so the whole company would share
# one bucket and legitimate users would start getting 429s. Set this to 1 when
# something else terminates TLS in front of the app so the real client IP is read
# from X-Forwarded-For. Leave unset when the app is directly internet-facing —
# trusting the header then lets a client forge it and bypass the limit.
# TRUST_PROXY_HEADERS=1
# AI_RATE_LIMIT_PER_HOUR=60      # per-user cap on /ai/* calls (each one bills DEEPSEEK_API_KEY)

# ── Tokens ──────────────────────────────────────────────────────────────────
# PAT_TTL_DAYS=90                # lifetime of new personal access tokens (MCP)

# ── Security headers ────────────────────────────────────────────────────────
# CSP ships as Content-Security-Policy-Report-Only. Watch the browser console for
# violations, then flip this to 1 to enforce it.
# CSP_ENFORCE=1

# ── URLs ────────────────────────────────────────────────────────────────────
ZET_PUBLIC_URL=http://localhost:8000        # real https origin in prod (OAuth/MCP metadata)

# ── First deploy: create the superadmin ────────────────────────────────────
# No account can approve users until this has run once against the database:
#   cd backend && python scripts/seed_superadmin.py            # dry run
#   cd backend && python scripts/seed_superadmin.py --apply    # writes
SUPERADMIN_EMAIL=swamy@driftal.tech   # read only by scripts/seed_superadmin.py

# ── Aurora TLS ──────────────────────────────────────────────────────────────
# Connections verify the server certificate against backend/certs/rds-global-bundle.pem,
# which is committed so a deployed container never fetches it at connect time.
# verify-full fails closed: if the chain or hostname ever fails to validate the app
# cannot reach the database. Downgrade WITHOUT a redeploy by setting:
#   DB_SSL_MODE=require        # encrypt only, no certificate validation
# DB_SSL_MODE=verify-full
# DB_SSL_ROOT_CERT=            # override the CA bundle path
# DB_CONNECT_TIMEOUT=10

# ── Aurora PostgreSQL (IAM) — required ─────────────────────────────────────
# These are Postgres usernames and Aurora hostnames — NOT AWS credentials.
# Never put an Access Key ID (AKIA...) or secret key in DB_USER.
# Auth is ALWAYS a short-lived IAM token generated per connection (boto3
# generate_db_auth_token) — there is no database password. The runtime therefore
# needs AWS credentials: in production attach a task/instance role granting
#   rds-db:connect on arn:aws:rds-db:<region>:<account>:dbuser:<cluster-res-id>/<DB_USER>
# DB_AUTH_TOKEN can supply a token manually when no AWS credentials exist (testing).
# Connector package (default: test-db-connection/connect_rds_iam.py)
# Required (no aliases, no silent fallback to the master user):
# DB_CONNECTOR_PATH=test-db-connection
# DB_USER=app_user
# DB_WRITE_HOST=your-cluster.cluster.region.rds.amazonaws.com
# DB_READ_HOST=your-cluster.cluster-ro.region.rds.amazonaws.com
# AWS_REGION=ap-south-2
# DB_PORT=5432
# DB_NAME=postgres
# Schema bootstrapped automatically on startup (scripts/bootstrap_aurora.sql)

# ── Ops (optional) ──────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_RATE=0.1
# REQUIRED in prod unless ALLOW_SINGLE_WORKER=1. Realtime version counters are
# per-process, so with more than one uvicorn worker a write only reaches the clients
# attached to the worker that served it. The app refuses to boot without one of these.
# REDIS_URL=redis://localhost:6379/0
# ALLOW_SINGLE_WORKER=1                       # deliberately running one worker

# ── Clockify (optional — timesheet import) ──────────────────────────────────
# CLOCKIFY_API_KEY=               # workspace API key
# CLOCKIFY_WORKSPACE_ID=          # workspace UUID from Clockify
