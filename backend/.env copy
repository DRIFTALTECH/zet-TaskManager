# ── Auth / admin (dev defaults apply; MUST be set for APP_ENV=production) ─────
# APP_ENV=development                 # set to "production" to enforce the checks below
# TASKMANAGER_JWT_SECRET=             # >=32 chars in prod; dev uses a built-in default
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=                     # >=8 chars in prod; dev default is Default@123
# CORS_ORIGINS=https://app.example.com,https://admin.example.com   # required in prod

# ── Public URL (OAuth/MCP discovery metadata) ───────────────────────────────
# ZET_PUBLIC_URL=http://localhost:8000        # set to the real https origin in prod

# ── Database (defaults to local SQLite; set for Postgres) ────────────────────
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/zet
# TASKMANAGER_SQLITE_PATH=./data/taskmanager.db

