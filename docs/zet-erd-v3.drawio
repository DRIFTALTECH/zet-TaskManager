er&quot;&gt;&lt;b&gt;personal_access_tokens&lt;/b&gt;&lt;/p&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;id&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[FK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;user_id&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt; &lt;font color=&quot;#1565c0&quot;&gt;→ users.id&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;name&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[UK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;token_hash&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;prefix&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;created_at&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;last_used_at&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt; &lt;font color=&quot;#888&quot;&gt;(optional)&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;revoked&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;boolean&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;ht