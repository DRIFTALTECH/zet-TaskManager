time logs, …" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="180" height="70" as="geometry"/></mxCell><mxCell id="se0" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;fontColor=#333;" edge="1" parent="1" source="s_users" target="s_proj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se1" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;fontColor=#333;" edge="1" parent="1" source="s_proj" target="s_story"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se2" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;fontColor=#333;" edge="1" parent="1" source="s_story" target="s_task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se3" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;fontColor=#333;" edge="1" parent="1" source="s_task" target="s_extra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tabs" value="&lt;b&gt;Open these tabs (bottom of draw.io)&lt;/b&gt;&lt;br/&gt;1 People · 2 Projects · 3 Stories · 4 Tasks · 5 Task extras · 6 Timesheets · 7 Alerts and Meetings · 8 Alone · All joins (list)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="900" height="70" as="geometry"/></mxCell><mxCell id="src" value="Source of truth: backend/scripts/bootstrap_aurora.sql · 26 tables · 45 foreign keys" style="text;html=1;fontSize=12;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="700" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="1 People" name="1 People"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="1 · People" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="600" height="30" as="geometry"/></mxCell><mxCell id="blurb" value="A USER is a person using ZET. Their boss can be another user (manager_id). A PERSONAL ACCESS TOKEN is a secret key that belongs to one user (for MCP / API)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="720" height="70" as="geometry"/></mxCell><mxCell id="t_users" value="&lt;p style=&quot;margin:0;padding:6px 8px;background:#f8cecc;border-bottom:2px solid #b85450;font-size:14px;text-align:center&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/p&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;id&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;name&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[UK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;email&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;password_hash&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;