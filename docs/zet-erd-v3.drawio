<diagram id="2 Projects" name="2 Projects"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="2 · Projects" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="600" height="30" as="geometry"/></mxCell><mxCell id="blurb" value="A CLIENT is a customer. A PROJECT belongs to a client and was created by a user. PROJECT_MEMBERS links people to projects (many-to-many). A SECTION is a folder inside a project." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="720" height="70" as="geometry"/></mxCell><mxCell id="t_clients" value="&lt;p style=&quot;margin:0;padding:6px 8px;background:#d5e8d4;border-bottom:2px solid #82b366;font-size:14px;text-align:center&quot;&gt;&lt;b&gt;clients&lt;/b&gt;&lt;/p&gt;&lt;br/&gt;&lt;font color=&quot;#b35900&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt;&lt;/font&gt; &lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;id&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;name&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;created_at&lt;/font&gt; &lt;font color=&quot;#666&quot; style=&quot;font-size:10px&quot;&gt;varchar&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=0;spacingBottom=6;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="300" height="98" as