# Copy to test-db-connection/.env and fill values (gitignored).
# Used by connect_rds_iam.py and by ZET backend/db_wrapper/pool.py.
#
# These are Postgres usernames and Aurora hostnames — NOT AWS credentials.
# Never put an Access Key ID (AKIA...) or secret key in DB_USER.
# Required: DB_USER, DB_WRITE_HOST, DB_READ_HOST, AWS_REGION.
# There are no RDS_* / DB_HOST aliases. A missing DB_USER does not become postgres.

DB_USER=app_user
DB_WRITE_HOST=
DB_READ_HOST=
DB_PORT=5432
DB_NAME=postgres
AWS_REGION=ap-south-2
