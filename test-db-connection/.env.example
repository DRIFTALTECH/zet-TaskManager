# Copy to test-db-connection/.env and fill values (gitignored).
# Used by connect_rds_iam.py and by ZET backend/db_wrapper/pool.py.

# Preferred (read/write split for Aurora)
DB_WRITE_HOST=
DB_READ_HOST=

# Legacy aliases (still supported)
# RDS_HOSTNAME=   # treated as write host
# DB_HOST=        # treated as read host (falls back to write)

DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
AWS_REGION=ap-south-2
