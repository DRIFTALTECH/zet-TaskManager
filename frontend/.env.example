# ZET frontend — copy to frontend/.env for Microsoft sign-in (gitignored).
# API URL (required) lives in committed mode files:
#   frontend/.env.development  → http://localhost:8000  (npm run dev)
#   frontend/.env.production   → https://zetapi.driftal.tech  (npm run build)
# Override locally via gitignored .env.local / .env.development.local / .env.production.local
# or uncomment VITE_API_URL below. If unset, the app fails fast at startup.# Microsoft sign-in (buttons appear only when client id is set). Same values as backend.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=          # optional; defaults to "common" when unset

# MCP endpoint shown in Settings → Developer settings. Defaults to <VITE_API_URL>/mcp.
# VITE_MCP_URL=https://zetapi.driftal.tech/mcp
# VITE_MCP_URL=http://localhost:8000/mcp
